# --- Server ---
PORT=4000
NODE_ENV=development
# Comma-separated list of origins allowed to call this API (your frontend URL)
CORS_ORIGIN=http://localhost:3000

# --- Database (Postgres — e.g. Neon / Supabase / Railway) ---
DATABASE_URL=
# --- Admin auth (email + password login, protects write endpoints + admin-only reads) ---
# Used to sign/verify the JWT issued by POST /auth/login. Use a long random string.
JWT_SECRET=
JWT_EXPIRES_IN=7d


# The single admin account, created by `npm run db:seed`. Change the password
# afterwards from the DB if you like — these vars are only read at seed time.
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=

# --- Rate limiting (contact form) ---
THROTTLE_TTL=60
THROTTLE_LIMIT=5

# --- File uploads (avatar image + resume PDF) — free account at cloudinary.com ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Outgoing email (contact form notifications) ---
# Choose ONE provider.

# Option A: SMTP (works with Gmail App Passwords, Mailtrap, Zoho, etc.)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password

# Option B: Resend (set RESEND_API_KEY and leave SMTP_* blank to use Resend instead)
RESEND_API_KEY=

# Where contact messages get delivered, and the "from" address used to send them
MAIL_TO=owner@example.com
MAIL_FROM="Portfolio Contact" <no-reply@yourdomain.com>
